config instance 'awg0'
    option enabled '0'
    option listen '127.0.0.1'
    option port '5353'
    option upstream '9.9.9.10'
    option upstream_port '53'
    option range '10.32.0.0/15'
    option table 'dnsmap_awg0'
    option route_table '101'
    option mark '0x101'
    option interface 'awg0'
    option workers '2'
    option verbose '0'

config instance 'awg1'
    option enabled '0'
    option listen '127.0.0.1'
    option port '5453'
    option upstream '9.9.9.10'
    option upstream_port '53'
    option range '10.64.0.0/15'
    option table 'dnsmap_awg1'
    option route_table '102'
    option mark '0x102'
    option interface 'awg1'
    option workers '2'
    option verbose '0'
