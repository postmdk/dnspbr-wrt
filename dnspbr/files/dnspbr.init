#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG="/usr/bin/dnspbr"
CONF="dnspbr"

find_dnsmasq_dir() {
	local dir
	for dir in /tmp/dnsmasq*d; do
		if [ -d "$dir" ]; then
			echo "$dir"
			return 0
		fi
	done
	return 1
}

sync_dnsmasq_configs() {
	local dnsmasq_dir
	dnsmasq_dir=$(find_dnsmasq_dir)
	[ -z "$dnsmasq_dir" ] && return 1

	local had_old=0
	ls "$dnsmasq_dir"/dnspbr_*.conf >/dev/null 2>&1 && had_old=1
	rm -f "$dnsmasq_dir"/dnspbr_*.conf

	local found=0
	local conf

	for conf in /etc/dnspbr/dnsmasq/*.conf /etc/dnspbr/dnsmasq/*/*.conf; do
		if [ -f "$conf" ]; then
			cp "$conf" "$dnsmasq_dir/dnspbr_$(basename "$conf")"
			found=1
		fi
	done

	if [ "$found" -eq 1 ] || [ "$had_old" -eq 1 ]; then
		/etc/init.d/dnsmasq restart
	fi
}

cleanup_instance() {
	local s="$1"
	local table route_table mark state_file

	config_get table "$s" "table" "dnsmap_${s}"
	config_get route_table "$s" "route_table" "100"
	config_get mark "$s" "mark" "0"

	state_file="/var/run/dnspbr_${s}.range"
	rm -f "$state_file"

	if [ -n "$table" ]; then
		nft flush table ip "$table" 2>/dev/null
		nft delete table ip "$table" 2>/dev/null
		nft flush table ip "mangle_${table}" 2>/dev/null
		nft delete table ip "mangle_${table}" 2>/dev/null
	fi

	if [ -n "$mark" ] && [ "$mark" != "0" ]; then
		while ip rule del fwmark "$mark" table "$route_table" 2>/dev/null; do
			:
		done
	fi
	[ -n "$route_table" ] && ip route flush table "$route_table" 2>/dev/null
}

disable_instance_conf() {
	local s="$1"
	local enabled
	config_get_bool enabled "$s" "enabled" 0
	if [ "$enabled" -eq 0 ]; then
		rm -f "/etc/dnspbr/dnsmasq/${s}.conf"
	fi
}

get_instance_iface() {
	local s="$1"
	local iface
	config_get iface "$s" "interface" ""
	[ -z "$iface" ] && config_get iface "$s" "tunnel_iface" ""
	printf '%s\n' "$iface"
}

start_instance() {
	local s="$1"

	local enabled
	config_get_bool enabled "$s" "enabled" 0
	[ "$enabled" -eq 1 ] || return 0

	local address port upstream upstream_port range mark table route_table tunnel_iface workers verbose
	config_get address "$s" "listen" ""
	[ -z "$address" ] && config_get address "$s" "address" "0.0.0.0"
	config_get port "$s" "port" "5353"
	config_get upstream "$s" "upstream" "9.9.9.10"
	config_get upstream_port "$s" "upstream_port" "53"
	config_get range "$s" "range" ""
	config_get mark "$s" "mark" "0"
	config_get table "$s" "table" "dnsmap_${s}"
	config_get route_table "$s" "route_table" "100"
	tunnel_iface=$(get_instance_iface "$s")
	config_get workers "$s" "workers" ""
	config_get_bool verbose "$s" "verbose" 0

	[ -n "$range" ] && printf '%s\n' "$range" > "/var/run/dnspbr_${s}.range"

	procd_open_instance "$s"
	procd_set_param command "$PROG" -a "$address" -p "$port" -u "$upstream" -t "$table" -T "$route_table" -m "$mark"
	[ -n "$upstream_port" ] && procd_append_param command -P "$upstream_port"
	[ -n "$range" ] && procd_append_param command -r "$range"
	[ -n "$tunnel_iface" ] && procd_append_param command -i "$tunnel_iface"
	[ -n "$workers" ] && procd_append_param command -w "$workers"
	[ "$verbose" -eq 1 ] && procd_append_param command -v

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load "$CONF"
	config_foreach disable_instance_conf instance
	sync_dnsmasq_configs
	config_foreach start_instance instance
}

stop_service() {
	config_load "$CONF"
	config_foreach cleanup_instance instance

	local dnsmasq_dir
	dnsmasq_dir=$(find_dnsmasq_dir)
	if [ -n "$dnsmasq_dir" ]; then
		rm -f "$dnsmasq_dir"/dnspbr_*.conf
		/etc/init.d/dnsmasq restart
	fi
}

reload_service() {
	stop
	start
}

add_iface_trigger() {
	local s="$1"
	local enabled tunnel_iface
	config_get_bool enabled "$s" "enabled" 0
	[ "$enabled" -eq 1 ] || return 0
	tunnel_iface=$(get_instance_iface "$s")
	if [ -n "$tunnel_iface" ]; then
		procd_add_interface_trigger "interface.*.up" "$tunnel_iface" /etc/init.d/dnspbr restart
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	config_load "$CONF"
	config_foreach add_iface_trigger instance
}
